APP_NAME=ichri.tn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ichri
DB_USERNAME=ichri_user
DB_PASSWORD=ichri_password

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ichri.tn"
MAIL_FROM_NAME="${APP_NAME}"

# ElasticSearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# PostgreSQL Analytics
ANALYTICS_DB_CONNECTION=pgsql
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_DATABASE=ichri_analytics
ANALYTICS_DB_USERNAME=ichri_user
ANALYTICS_DB_PASSWORD=ichri_password

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT
JWT_SECRET=
JWT_TTL=1440

# Twilio (SMS)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# OneSignal (Push Notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Payment Gateways
# Cartunisie
CARTUNISIE_MERCHANT_ID=
CARTUNISIE_API_KEY=
CARTUNISIE_SECRET_KEY=

# PayMe
PAYME_MERCHANT_ID=
PAYME_API_KEY=

# D-Dinar (Poste)
DDINAR_MERCHANT_ID=
DDINAR_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Application Settings
MIN_ORDER_AMOUNT=50
FREE_DELIVERY_THRESHOLD=0
DELIVERY_FEE=0
MAX_DELIVERY_DISTANCE=50

# Credit Settings
CREDIT_ENABLED=true
CREDIT_MIN_SCORE=60
CREDIT_DEFAULT_LIMIT=500
CREDIT_MAX_LIMIT=15000

# Business Settings
GMV_TARGET_YEAR_1=30000000
ACTIVE_GROCERS_TARGET=5000
AVERAGE_BASKET=250
ORDER_FREQUENCY_MONTHLY=3.5
