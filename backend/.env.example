# ==================================
# ichri.tn - Environment Configuration
# ==================================

# Application
APP_NAME="ichri.tn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=2.0.0

# Frontend URLs
FRONTEND_URL=http://localhost:3000
MOBILE_APP_SCHEME=ichri://

# Database - MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ichri
DB_USERNAME=root
DB_PASSWORD=

# Database - PostgreSQL (Analytics)
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=ichri_analytics
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ElasticSearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=ichri

# JWT Authentication
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# SMS & OTP (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SID=
OTP_EXPIRY_MINUTES=10

# Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ichri.tn"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=ichri-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Firebase (Push Notifications)
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Payment Gateways - Flouci (Tunisia)
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_SANDBOX=true

# Business Configuration
CREDIT_MIN_SCORE=60
DELIVERY_FEE=7.000
FREE_DELIVERY_THRESHOLD=100.000
COMMISSION_MOBILE_TOPUP=3.0
COMMISSION_ELECTRICITY=1.5
KARNY_DEFAULT_CREDIT_LIMIT=500

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Localization
APP_LOCALE=fr
APP_TIMEZONE=Africa/Tunis
